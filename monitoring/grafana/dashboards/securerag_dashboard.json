          "datasource": { "type": "postgres", "uid": "PostgreSQL-SecureRAG" },
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT CASE WHEN count(*) = 0 THEN 0 ELSE (SUM(CASE WHEN sentiment = 'positive' THEN 1 ELSE 0 END)::float / count(*)) * 100 END as positive_pct FROM feedback;",
